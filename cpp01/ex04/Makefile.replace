CCCC= g++
CCPPFLAGS= -Wall -Wextra -Werror -std=c++98
RM= rm -rf
NAME= winner
SRCCS= main.cpp   ReplaceFile.cpp
OBJS= ${SRCCS:.cpp=.o}

all:${NAME}

${NAME}:${OBJS}
	${CCCC} ${CCPPFLAGS} ${OBJS} -o $(NAME)

clean:
	${RM} ${OBJS}

fclean:clean
	${RM} ${NAME}

re:fclean all